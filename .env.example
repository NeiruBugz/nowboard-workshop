# Copy this file to .env and fill in values before running `docker compose up`.

# Signing key for session cookies and token serializers. Generate a real value in prod.
SECRET_KEY=change-me-in-prod

# SQLite database URL. The path resolves inside the `web` container to the
# named volume `nowboard-db` mounted at /data.
DATABASE_URL=sqlite+aiosqlite:////data/nowboard.db

# Public base URL used to build invite URLs.
APP_BASE_URL=http://localhost:8000
